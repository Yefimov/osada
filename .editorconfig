root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true


[*.{kt,kts}]
indent_style = space
indent_size = 4
max_line_length = 120
# Использовать официальный стиль Kotlin.
ij_kotlin_code_style_defaults = KOTLIN_OFFICIAL

# Никогда не сворачивать обычные импорты пакета в import package.*.
ij_kotlin_name_count_to_use_star_import = 2147483647

# Никогда не сворачивать импорты enum/static members в import Type.*.
ij_kotlin_name_count_to_use_star_import_for_members = 2147483647

# Не держать исключений, для которых wildcard import принудительно разрешён.
ij_kotlin_packages_to_use_import_on_demand = unset