[Unit]
Description=OSADA game and multiplayer room server
Documentation=https://github.com/Yefimov/osada
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=osada
Group=osada
WorkingDirectory=/opt/osada

# Loopback only: nginx terminates :80 (and later :443) and proxies here. Foundry VTT owns :30000
# and imchargen owns :8080, so the room server must not take either.
Environment=OSADA_HOST=127.0.0.1
Environment=OSADA_PORT=8090
Environment=OSADA_WEB_ROOT=/opt/osada/web

# Which origins may open a room socket. An empty value accepts any page on the internet, which lets
# a stranger's site create rooms in a visitor's browser until the server's room limit is reached, so
# it is pinned to the origin the game is actually served from. bootstrap-server.sh substitutes the
# placeholder with that origin, which is why this public file does not name the host. After a
# certificate is issued, set it to https://<domain>; add a dev origin while testing a local build.
Environment=OSADA_ALLOWED_ORIGINS=__OSADA_ORIGIN__

ExecStart=/opt/osada/server/bin/osada-server
Restart=on-failure
RestartSec=5

# The box has ~2 GB of RAM shared with Foundry VTT and imchargen. Quoted because systemd would
# otherwise read everything after the first space as further assignments and drop the setting.
Environment="JAVA_OPTS=-Xms32m -Xmx192m -XX:+UseSerialGC"

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/osada
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictSUIDSGID=true

StandardOutput=journal
StandardError=journal
SyslogIdentifier=osada

[Install]
WantedBy=multi-user.target
